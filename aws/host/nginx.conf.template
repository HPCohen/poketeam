map_hash_bucket_size 128;
# Aggregate API limit protects the small origin. This is not a WAF or billing cap.
limit_req_zone $server_name zone=api:1m rate=20r/s;
limit_req_status 429;
map $http_x_poketeam_origin $trusted_origin {
    default 0;
    "__ORIGIN_TOKEN__" 1;
}
server {
    listen 80 default_server;
    server_name _;
    if ($trusted_origin = 0) { return 403; }
    client_max_body_size 16k;
    root /usr/share/nginx/html/current;
    index index.html;

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 65s;
    }
    location /health/ {
        proxy_pass http://api:3000;
    }
    location = /openapi.json {
        proxy_pass http://api:3000;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
