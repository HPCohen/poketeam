DATABASE_URL=postgres://poketeam:poketeam@localhost:5432/poketeam
LISTEN_ADDR=0.0.0.0:3000
PUBLIC_ORIGIN=http://localhost:3000
UPSTREAM_URL=https://pokeapi.co/api/v2/
UPSTREAM_ALLOWED_HOSTS=pokeapi.co,raw.githubusercontent.com
ALLOW_INSECURE_UPSTREAM=false
SCAN_INTERVAL_SECONDS=86400
RUST_LOG=poketeam=info,tower_http=info

# Optional operator-only demo endpoint; leave empty to keep it disabled.
# Set a random token with at least 32 printable non-space ASCII characters.
DEMO_UPDATE_TOKEN=
