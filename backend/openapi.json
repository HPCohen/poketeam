  "components": {
    "schemas": {
      "BTreeMap": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          },
          "propertyNames": {
            "type": "string"
          }
        },
        "propertyNames": {
          "type": "string"
        }
      },
      "CatalogPage": {
        "type": "object",
        "required": [
          "pokemon",
          "total",
          "limit",
          "offset",
          "catalog_revision"
        ],
        "properties": {
          "catalog_revision": {
            "type": "integer",
            "format": "int64"
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "pokemon": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pokemon"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CatalogStatus": {
        "type": "object",
        "required": [
          "revision"
        ],
        "properties": {
          "last_success_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "latest_run": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RefreshRun"
              }
            ]
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CounterRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/Mode"
          }
        },
        "additionalProperties": false
      },
      "CounterResult": {
        "type": "object",
        "required": [
          "mode",
          "algorithm_version",
          "pokemon",
          "source_total",
          "source_average",
          "counter_total",
          "counter_average",
          "percentage_stat_difference",
          "coverage",
          "matchup_score",
          "shared_weaknesses",
          "explanations",
          "catalog_revision"
        ],
        "properties": {
          "algorithm_version": {
            "type": "string"
          },
          "catalog_revision": {
            "type": "integer",
            "format": "int64"
          },
          "counter_average": {
            "type": "number",
            "format": "double"
          },
          "counter_total": {
            "type": "integer",
            "format": "int32"
          },
          "coverage": {
            "type": "integer",
            "minimum": 0
          },
          "explanations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpponentExplanation"
            }
          },
          "matchup_score": {
            "type": "number",
            "format": "double"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "percentage_stat_difference": {
            "type": "number",
            "format": "double"
          },
          "pokemon": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pokemon"
            }
          },
          "shared_weaknesses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SharedWeakness"
            }
          },
          "source_average": {
            "type": "number",
            "format": "double"
          },
          "source_total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CreateTeam": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "pokemon_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        },
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {},
          "message": {
            "type": "string"
          }
        }
      },
      "Mode": {
        "type": "string",
        "enum": [
          "power",
          "rival"
        ]
      },
      "Notification": {
        "type": "object",
        "required": [
          "id",
          "pokemon",
          "affected_team_ids",
          "detected_at",
          "differences",
          "descriptions"
        ],
        "properties": {
          "affected_team_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "descriptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detected_at": {
            "type": "string",
            "format": "date-time"
          },
          "differences": {},
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "pokemon": {
            "$ref": "#/components/schemas/Pokemon"
          }
        }
      },
      "NotificationPage": {
        "type": "object",
        "required": [
          "notifications",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "notifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
