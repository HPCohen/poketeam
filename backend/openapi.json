            "type": "string"
          },
          "best_attacker_id": {
            "type": "integer",
            "format": "int32"
          },
          "effectiveness": {
            "type": "number",
            "format": "double"
          },
          "opponent_id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Pokemon": {
        "type": "object",
        "required": [
          "id",
          "species_id",
          "name",
          "types",
          "stats",
          "base_stat_total",
          "active"
        ],
        "properties": {
          "active": {
            "type": "boolean"
